# Copie para .env apenas no uso local. Não publique a senha no repositório.
ADMIN_USERNAME=
ADMIN_PASSWORD=
PORT=4173
DATA_DIR=./data
# Banco compartilhado gratuito. Preencha estes dois campos no Render.
# Sem eles, somente o uso local de desenvolvimento utiliza SQLite nesta pasta.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Em produção, defina NODE_ENV=production. O banco Turso é obrigatório.
# Opcional: PUBLIC_ORIGIN=https://nome-do-site.onrender.com
